# FlyBy web — environment variables.
#
# Copy this file to `.env` and fill in your values. `.env` is
# .gitignored so local secrets never land in version control.
# Node's built-in `--env-file-if-exists=.env` flag (wired into
# the `dev` npm script) loads this file automatically; missing
# file means the defaults kick in and the app falls back to
# anonymous OpenSky access.

# ---- OpenSky Network OAuth2 credentials ---------------------
# OpenSky deprecated HTTP Basic auth; they now require OAuth2
# client_credentials. Create a client at:
#   https://opensky-network.org/my-opensky/api-clients
# after signing in with your account, then paste the id/secret
# below. Without these, FlyBy still works but you get
# anonymous rate limits: ~10 s minimum spacing on /states/all
# and ~400 credits/day on /tracks/all, which is typically not
# enough for an always-on display.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
